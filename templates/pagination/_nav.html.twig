{% if pagination.totalPages > 1 %}
    <nav aria-label="Pagination">
        <ul class="pagination">
            <li class="page-item {{ pagination.hasPrevious ? '' : 'disabled' }}">
                <a class="page-link" href="{{ pagination.hasPrevious ? pageUrls[pagination.page - 1] : '#' }}">Précédent</a>
            </li>

            <li class="page-item {{ pagination.page == 1 ? 'active' : '' }}">
                <a class="page-link" href="{{ pageUrls[1] }}">1</a>
            </li>

            {% if pagination.page - 1 > 2 %}
                <li class="page-item disabled"><span class="page-link">…</span></li>
            {% endif %}

            {% if pagination.hasPrevious and pagination.page - 1 > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ pageUrls[pagination.page - 1] }}">{{ pagination.page - 1 }}</a>
                </li>
            {% endif %}

            {% if pagination.page != 1 and pagination.page != pagination.totalPages %}
                <li class="page-item active">
                    <a class="page-link" href="{{ pageUrls[pagination.page] }}">{{ pagination.page }}</a>
                </li>
            {% endif %}

            {% if pagination.hasNext and pagination.page + 1 < pagination.totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ pageUrls[pagination.page + 1] }}">{{ pagination.page + 1 }}</a>
                </li>
            {% endif %}

            {% if pagination.page + 1 < pagination.totalPages - 1 %}
                <li class="page-item disabled"><span class="page-link">…</span></li>
            {% endif %}

            <li class="page-item {{ pagination.page == pagination.totalPages ? 'active' : '' }}">
                <a class="page-link" href="{{ pageUrls[pagination.totalPages] }}">{{ pagination.totalPages }}</a>
            </li>

            <li class="page-item {{ pagination.hasNext ? '' : 'disabled' }}">
                <a class="page-link" href="{{ pagination.hasNext ? pageUrls[pagination.page + 1] : '#' }}">Suivant</a>
            </li>
        </ul>
    </nav>
{% endif %}
