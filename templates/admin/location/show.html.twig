{% extends 'admin/base.html.twig' %}

{% block admin_title %}Location{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom">
        <h1 class="h3 mb-0">Location {{ location.customer ? '– ' ~ location.customer.companyName : '' }}</h1>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_location_index') }}">Retour</a>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Client</dt>
        <dd class="col-sm-9">{{ location.customer ? location.customer.companyName : '' }}</dd>

        <dt class="col-sm-3">Début</dt>
        <dd class="col-sm-9">{{ location.startAt|date('d/m/Y H:i') }}</dd>

        <dt class="col-sm-3">Fin</dt>
        <dd class="col-sm-9">{{ location.endAt|date('d/m/Y H:i') }}</dd>

        <dt class="col-sm-3">Statut</dt>
        <dd class="col-sm-9">{{ status_badge(location.status) }}</dd>

        <dt class="col-sm-3">Prix total</dt>
        <dd class="col-sm-9">{{ location.totalPrice|number_format(2, ',', ' ') }} €</dd>

        <dt class="col-sm-3">Matériels</dt>
        <dd class="col-sm-9">
            <ul class="mb-0">
                {% for material in location.materials %}
                    <li><a href="{{ path('app_admin_material_show', {uuid: material.uuid}) }}">{{ material.name }}</a></li>
                {% else %}
                    <li class="text-muted">Aucun matériel.</li>
                {% endfor %}
            </ul>
        </dd>
    </dl>

    <a class="btn btn-primary" href="{{ path('app_admin_location_edit', {uuid: location.uuid}) }}">Modifier</a>
{% endblock %}
