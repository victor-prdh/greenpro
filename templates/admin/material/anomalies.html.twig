{% extends 'admin/base.html.twig' %}

{% block admin_title %}Anomalies de statut{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom">
        <h1 class="h3 mb-0">Anomalies de statut</h1>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_material_index') }}">Retour aux matériels</a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Référence</th>
                <th>Statut actuel</th>
                <th>Statut attendu</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for material in pagination %}
                {% set expectedStatus = material.status.value == 'available' ? constant('App\\Entity\\Enum\\MaterialStatusEnum::RENTED') : constant('App\\Entity\\Enum\\MaterialStatusEnum::AVAILABLE') %}
                <tr class="table-warning">
                    <td>{{ material.name }}</td>
                    <td>{{ material.reference }}</td>
                    <td>{{ status_badge(material.status) }}</td>
                    <td>{{ status_badge(expectedStatus) }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_material_edit', {uuid: material.uuid}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted">Aucune anomalie.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ paginator_nav(pagination) }}
{% endblock %}
