{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ user.email }}{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom">
        <h1 class="h3 mb-0">{{ user.email }}</h1>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_user_index') }}">Retour</a>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">{{ user.email }}</dd>

        <dt class="col-sm-3">Rôles</dt>
        <dd class="col-sm-9">{{ user.roles|join(', ') }}</dd>

        <dt class="col-sm-3">Créé le</dt>
        <dd class="col-sm-9">{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '' }}</dd>
    </dl>

    <a class="btn btn-primary" href="{{ path('app_admin_user_edit', {uuid: user.uuid}) }}">Modifier</a>
{% endblock %}
