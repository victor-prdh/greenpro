{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ customer.companyName }}{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom">
        <h1 class="h3 mb-0">{{ customer.companyName }}</h1>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_customer_index') }}">Retour</a>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Contact</dt>
        <dd class="col-sm-9">{{ customer.contactName }}</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">{{ customer.email }}</dd>

        <dt class="col-sm-3">Téléphone</dt>
        <dd class="col-sm-9">{{ customer.phone }}</dd>

        <dt class="col-sm-3">Adresse</dt>
        <dd class="col-sm-9">{{ customer.address }}, {{ customer.postalCode }} {{ customer.city }}</dd>
    </dl>

    {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-primary" href="{{ path('app_admin_customer_edit', {uuid: customer.uuid}) }}">Modifier</a>
    {% endif %}
{% endblock %}
