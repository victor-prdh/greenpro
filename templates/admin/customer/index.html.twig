{% extends 'admin/base.html.twig' %}

{% block admin_title %}Clients{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center pb-2 mb-4 border-bottom">
        <h1 class="h3 mb-0">Clients</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-primary" href="{{ path('app_admin_customer_new') }}">Nouveau client</a>
        {% endif %}
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Société</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Ville</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for customer in pagination %}
                <tr>
                    <td>{{ customer.companyName }}</td>
                    <td>{{ customer.contactName }}</td>
                    <td>{{ customer.email }}</td>
                    <td>{{ customer.city }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_customer_show', {uuid: customer.uuid}) }}">Voir</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_customer_edit', {uuid: customer.uuid}) }}">Modifier</a>
                            <form class="d-inline" method="post" action="{{ path('app_admin_customer_delete', {uuid: customer.uuid}) }}" onsubmit="return confirm('Supprimer ce client ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-customer-' ~ customer.uuid) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted">Aucun client.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ paginator_nav(pagination) }}
{% endblock %}
